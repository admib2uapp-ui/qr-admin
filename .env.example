# Supabase - copy these from qr-web-nextjs/.env.local
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

POSTHOG_PERSONAL_API_KEY=posthog_personal_api-key
POSTHOG_PROJECT_ID=posthog_project_id
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# VAPID keys for PWA push notifications
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key

SOUNDBOX_WORKER_URL=https://soundbox.qr4pos.com
SOUNDBOX_ADMIN_TOKEN=soundbox_worker_admin_token
